# Copy to .env and fill in real values. .env is gitignored; never commit credentials.
# Defaults below match the local Docker Postgres (`docker compose up -d db`).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=workhub
POSTGRES_PASSWORD=workhub
POSTGRES_DB=workhub
POSTGRES_SSLMODE=prefer

# Temporary until Entra sign-in (WH-04): lets you call the API with an X-User-Id header. Never true in production.
DEV_AUTH=false

# Microsoft Entra sign-in (WH-04): from the Azure app registration's Overview page. Not secrets.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Hosted Azure Postgres: set these instead.
#   POSTGRES_HOST=<server>.postgres.database.azure.com
#   POSTGRES_USER=<user>          (older single-server instances need <user>@<server>)
#   POSTGRES_PASSWORD=<password>
#   POSTGRES_DB=<database>
#   POSTGRES_SSLMODE=require
# The Azure firewall must allow your current IP address.
